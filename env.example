DISCORD_TOKEN=your-new-discord-bot-token
HENRIK_API_KEY=your-new-henrikdev-key
TEAM_NAME=YourTeamName
TEAM_TAG=TAG
# Optional but more reliable: your team's ID (overrides name/tag)
TEAM_ID=
# Optional: your players as name#tag, comma separated (finds Premier matches reliably)
ROSTER=
AFFINITY=eu
# Optional: your server ID, makes slash commands appear instantly
GUILD_ID=

# Optional: auto-read the schedule tweet (needs X API read access)
X_BEARER_TOKEN=
X_USERNAME=
X_KEYWORD=premier
