# Required: use real values only in .env, never commit credentials.
DISCORD_TOKEN=
HENRIK_API_KEY=

# Optional: enables Gemini match recaps (free-tier availability and limits vary).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Premier team lookup: TEAM_ID takes precedence over name/tag.
TEAM_ID=
TEAM_NAME=YourTeamName
TEAM_TAG=TAG
# Optional comma-separated Riot IDs, e.g. PlayerOne#EU,PlayerTwo#EU
ROSTER=
AFFINITY=eu
# Optional guild-specific command sync; otherwise commands sync globally.
GUILD_ID=

# Optional X API schedule lookup.
X_BEARER_TOKEN=
X_USERNAME=
X_KEYWORD=premier
